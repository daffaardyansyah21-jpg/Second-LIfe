# ============================================================================
# SECOND LIFE — Verified Student Experience Platform
# Environment Variable Configuration Template (.env.example)
# ============================================================================

# 1. Server & Application Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# 2. Security & Session Secrets
# Generate a strong 64-character hex string in production
SESSION_SECRET=replace-with-secure-64-char-random-secret-key-in-production
CSRF_SECRET=replace-with-secure-csrf-secret-key-in-production

# 3. Database Configuration
# Local SQLite database path (default for zero-dependency local deployment)
SQLITE_DB_PATH=./data/second_life.sqlite

# Optional PostgreSQL / Supabase connection (when scaling beyond local SQLite)
DATABASE_URL=postgresql://postgres:password@localhost:5432/second_life
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Private File Storage Configuration
# Directory outside public web root for controlled-access portfolio & submission files
PRIVATE_STORAGE_DIR=./data/private_uploads
MAX_UPLOAD_SIZE_MB=25

# 5. Optional Low-Cost Google Sheets / Google Apps Script Adapter
# Leave empty if not configured. The platform will accurately report status as
# "Not Configured (Using Primary Relational Database)" and will never fake connection.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_SHARED_SECRET=
GOOGLE_SHEETS_SPREADSHEET_ID=
